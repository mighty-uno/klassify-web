# Turso database connection for the Bee-Bud partner application form.
# Create a database at https://turso.tech and copy these from its dashboard.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ZeptoMail transactional email for the Bee-Bud application notification.
# API token from https://www.zeptomail.com -> Send Mail -> API Token.
ZEPTOMAIL_API_TOKEN=your-zepto-mail-api-token
ZEPTOMAIL_FROM_EMAIL=no-reply@skoobee.vidhiworks.com
ZEPTOMAIL_FROM_NAME=SkooBee
# Where the Bee-Bud application notification is delivered.
ZEPTOMAIL_TO_EMAIL=vidhiworks@zohomail.in
